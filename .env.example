# Environment variables for PDF Tools
# Copy this file to .env for local development

# Application
NODE_ENV=production

# Server Configuration (Docker)
PORT=3000

# Build Configuration
# PUBLIC_ prefix makes variables available to the frontend
BUN_PUBLIC_APP_NAME=PDF Tools
BUN_PUBLIC_APP_VERSION=1.0.0
BUN_PUBLIC_MAX_FILE_SIZE=104857600  # 100MB in bytes
BUN_PUBLIC_INDEXEDDB_CLEANUP_HOURS=24

# Feature Flags (for gradual rollout)
BUN_PUBLIC_FEATURE_JPG_TO_PDF=true
BUN_PUBLIC_FEATURE_MERGE_PDF=true
BUN_PUBLIC_FEATURE_ORGANIZE_PDF=true
BUN_PUBLIC_FEATURE_SPLIT_PDF=false
BUN_PUBLIC_FEATURE_COMPRESS_PDF=false

# Analytics (optional, privacy-focused only)
BUN_PUBLIC_ENABLE_ANALYTICS=false

# Debug Mode
BUN_PUBLIC_DEBUG=false
