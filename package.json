{
  "name": "pdf-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun run setup:worker && bun scripts/build.js",
    "start": "NODE_ENV=production bun src/index.ts",
    "setup:worker": "bash scripts/setup-pdfjs-worker.sh",
    "generate:icons": "bash scripts/generate-icons.sh"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^6.26.0",
    "react-icons": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "file-saver": "^2.0.5",
    "idb": "^8.0.0",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "@types/file-saver": "^2.0.7",
    "bun-plugin-tailwind": "latest",
    "tailwindcss": "latest",
    "postcss": "latest",
    "autoprefixer": "latest",
    "@tailwindcss/postcss": "latest"
  }
}
