{
  "name": "pdf-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "file-saver": "^2.0.5",
    "idb": "^8.0.0",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "@types/file-saver": "^2.0.7",
    "bun-plugin-tailwind": "latest",
    "tailwindcss": "latest",
    "postcss": "latest",
    "autoprefixer": "latest",
    "@tailwindcss/postcss": "latest"
  }
}
